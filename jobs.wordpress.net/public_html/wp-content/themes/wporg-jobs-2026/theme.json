		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "12px",
					"name": "Extra small"
				},
				{
					"slug": "small",
					"size": "14px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "16px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "20px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "24px",
					"name": "Extra large"
				},
				{
					"slug": "h-6",
					"size": "22px",
					"name": "Heading 6"
				},
				{
					"slug": "h-5",
					"size": "26px",
					"name": "Heading 5"
				},
				{
					"slug": "h-4",
					"size": "30px",
					"name": "Heading 4"
				},
				{
					"slug": "h-3",
					"size": "36px",
					"name": "Heading 3"
				},
				{
					"slug": "h-2",
					"size": "50px",
					"name": "Heading 2"
				},
				{
					"slug": "h-1",
					"size": "70px",
					"name": "Heading 1"
				}
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Inter-normal-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/Inter-normal-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "heading",
					"name": "EB Garamond",
					"fontFamily": "\"EB Garamond\", serif",
					"fontFace": [
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/EBGaramond-normal-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/EBGaramond-normal-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/EBGaramond-italic-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/EBGaramond-italic-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"size": "10px",
					"name": "10"
				},
				{
					"slug": "20",
					"size": "20px",
					"name": "20"
				},
				{
					"slug": "30",
					"size": "30px",
					"name": "30"
				},
				{
					"slug": "40",
					"size": "clamp(30px, 5vw, 50px)",
					"name": "40"
				},
				{
					"slug": "50",
					"size": "clamp(40px, calc(5vw + 10px), 60px)",
					"name": "50"
				},
				{
					"slug": "60",
					"size": "clamp(20px, calc(10vw - 40px), 80px)",
					"name": "60"
				},
				{
					"slug": "80",
					"size": "clamp(80px, calc(6.67vw + 40px), 120px)",
					"name": "80"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card-hover",
					"name": "Card hover",
					"shadow": "0 2px 8px #3858e914"
				}
			]
		},
		"border": {
			"radiusSizes": [
				{
					"slug": "small",
					"size": "2px",
					"name": "Small"
				},
				{
					"slug": "pill",
					"size": "9999px",
					"name": "Pill"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.875"
		},
		"spacing": {
			"blockGap": "20px",
			"padding": {
				"left": "20px",
				"right": "20px",
				"top": "0px",
				"bottom": "0px"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|blueberry"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|blueberry-dark"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "400",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|h-1",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|h-2",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|h-3",
					"lineHeight": "1.28"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|h-4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|h-5"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|h-6"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|blueberry",
					"text": "var:preset|color|base"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.3"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|blueberry",
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "32px",
						"right": "32px"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|blueberry-dark",
						"text": "var:preset|color|base"
					},
					"border": {
						"color": "var:preset|color|blueberry-dark"
					}
				},
				":focus-visible": {
					"color": {
						"background": "var:preset|color|blueberry-dark",
						"text": "var:preset|color|base"
					}
				}
			},
			"textInput": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "normal"
				},
				"color": {
					"text": "var:preset|color|ink",
					"background": "var:preset|color|base"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|subtle",
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "8px",
						"bottom": "8px",
						"left": "15px",
						"right": "15px"
					}
				}
			},
			"select": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "normal"
				},
				"color": {
					"text": "var:preset|color|ink",
					"background": "var:preset|color|base"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var:preset|color|subtle",
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "8px",
						"bottom": "8px",
						"left": "15px",
						"right": "15px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var:preset|color|blueberry"
						},
						"border": {
							"width": "2px",
							"color": "currentColor"
						},
						"spacing": {
							"padding": {
								"top": "14px",
								"bottom": "14px",
								"left": "32px",
								"right": "32px"
							}
						},
						":hover": {
							"color": {
								"background": "var:preset|color|blueberry-dark",
								"text": "var:preset|color|base"
							},
							"border": {
								"color": "var:preset|color|blueberry-dark"
							}
						}
					}
				}
			},
			"core/navigation-link": {
				"typography": {
					"fontWeight": "500"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|blueberry"
					}
				},
				"-current": {
					"color": {
						"text": "var:preset|color|blueberry"
					},
					"typography": {
						"fontWeight": "700"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|hairline"
				}
			},
			"core/accordion-heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"lineHeight": "1.875"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"core/accordion-panel": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.875"
				},
				"color": {
					"text": "var:preset|color|muted"
				},
				"spacing": {
					"padding": {
						"bottom": "20px"
					}
				}
			},
			"core/accordion-item": {
				"border": {
					"bottom": {
						"color": "var:preset|color|hairline",
						"width": "1px",
						"style": "solid"
					}
				}
			},
			"core/accordion": {
				"spacing": {
					"margin": {
						"bottom": "var:preset|spacing|40"
					}
				}
			},
			"core/search": {
				"elements": {
					"button": {
						"typography": {
							"fontSize": "var:preset|font-size|small"
						},
						"spacing": {
							"padding": {
								"top": "7px",
								"bottom": "7px",
								"left": "12px",
								"right": "12px"
							}
						}
					},
					"textInput": {
						"typography": {
							"lineHeight": "normal"
						},
						"spacing": {
							"padding": {
								"top": "10px",
								"bottom": "10px",
								"left": "15px",
								"right": "15px"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "single-job",
			"title": "Single Job",
			"postTypes": [
				"job"
			]
		},
		{
			"name": "page-wide",
			"title": "Wide page",
			"postTypes": [
				"page"
			]
		}
	]
}