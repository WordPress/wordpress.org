				},
				{
					"slug": "charcoal-3",
					"color": "#40464d",
					"name": "Charcoal 3"
				},
				{
					"slug": "muted",
					"color": "#656a71",
					"name": "Muted"
				},
				{
					"slug": "subtle",
					"color": "#979aa1",
					"name": "Subtle"
				},
				{
					"slug": "hairline",
					"color": "#d9d9d9",
