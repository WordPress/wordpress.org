				{
					"slug": "mint-mid",
					"color": "#c7ffdb",
					"name": "Mint mid"
				},
				{
					"slug": "acid",
					"color": "#33f078",
					"name": "Acid green"
				}
			],
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true
