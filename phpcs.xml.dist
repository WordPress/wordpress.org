<?xml version="1.0"?>
<ruleset name="WordPress.org">
	<description>WordPress.org Coding Standards</description>

	<file>.</file>

	<!-- Exclude development files & folders. -->
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<!-- Exclude JS/CSS files. -->
	<exclude-pattern>*.js[x]?</exclude-pattern>
	<exclude-pattern>*.[s]?css</exclude-pattern>

	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Show sniff codes in all reports. -->
	<arg value="s"/>

	<!-- Use colors in output. -->
	<arg name="colors"/>

	<rule ref="WordPress" />
	<rule ref="WordPress-Docs" />

</ruleset>
