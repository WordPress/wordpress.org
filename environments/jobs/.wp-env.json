{
	"core": "https://wordpress.org/nightly-builds/wordpress-latest.zip",
	"phpVersion": "8.4",
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/jetpack.zip",
		"../jobs.wordpress.net/public_html/wp-content/plugins/jobswp"
	],
	"themes": [
		"../jobs.wordpress.net/public_html/wp-content/themes/jobswp",
		"../jobs.wordpress.net/public_html/wp-content/themes/jobswp-2025"
	],
	"mappings": {
		"wp-content/plugins/jobswp-blocks": "../jobs.wordpress.net/public_html/wp-content/plugins/jobswp-blocks",
		"wp-content/mu-plugins": "./jobs/mu-plugins",
		"wp-content/env-mocks": "./mocks"
	},
	"lifecycleScripts": {
		"afterStart": "bash jobs/bin/after-start.sh"
	},
	"config": {
		"WP_DEBUG": true,
		"JETPACK_DEV_DEBUG": true
	}
}
