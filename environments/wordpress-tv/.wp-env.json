{
	"core": "https://wordpress.org/nightly-builds/wordpress-latest.zip",
	"phpVersion": "8.4",
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/jetpack.zip"
	],
	"themes": [
		"../wordpress.tv/public_html/wp-content/themes/wptv-27"
	],
	"mappings": {
		"wp-content/mu-plugins": "./wordpress-tv/mu-plugins",
		"wp-content/env-mocks": "./mocks",
		"wp-content/env-bin": "./wordpress-tv/bin"
	},
	"lifecycleScripts": {
		"afterStart": "bash wordpress-tv/bin/after-start.sh"
	},
	"config": {
		"WP_DEBUG": true,
		"JETPACK_DEV_DEBUG": true
	}
}
