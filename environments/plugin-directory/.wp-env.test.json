{
	"core": "https://wordpress.org/nightly-builds/wordpress-latest.zip",
	"phpVersion": "8.4",
	"testsEnvironment": false,
	"plugins": [
		"../wordpress.org/public_html/wp-content/plugins/plugin-directory"
	],
	"mappings": {
		"wp-content/env-bin": "./plugin-directory/bin",
		"wp-content/mu-plugins/pub/locales": "../wordpress.org/public_html/wp-content/mu-plugins/pub/locales"
	},
	"lifecycleScripts": {
		"afterStart": "bash plugin-directory/bin/after-start-test.sh"
	},
	"config": {
		"GLOTPRESS_LOCALES_PATH": "/var/www/html/wp-content/mu-plugins/pub/locales/locales.php",
		"PLUGINS_TABLE_PREFIX": "wp_",
		"WP_GANDALF_SCAN_SHARED_SECRET": "local-dev-secret"
	}
}
