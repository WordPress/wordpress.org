{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "wporg/card",
	"version": "0.1.0",
	"title": "Release Card",
	"category": "design",
	"icon": "",
	"description": "A block to display a card.",
	"textdomain": "wporg",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"interactivity": true
	},
	"usesContext": [ "postId" ],
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"style": "file:./style-index.css"
}
