<?xml version="1.0" ?>
<ruleset name="WordPress.org FreeScout Coding Standards">
	<description>WordPress Coding Standards for FreeScout code, without the sniffs that assume WordPress.</description>

	<!-- Show sniff codes in all reports -->
	<arg value="ps" />
	<arg name="colors" />
	<arg name="extensions" value="php" />

	<file>.</file>
	<file>../environments/freescout</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!-- Blade templates are escaped by {{ }}, and aren't PHP phpcs can parse. -->
	<exclude-pattern>*.blade.php</exclude-pattern>

	<config name="testVersion" value="8.3-" />
	<rule ref="PHPCompatibility" />

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName" />
		<exclude name="WordPress.WP" />
		<exclude name="WordPress.DB" />
		<exclude name="WordPress.Security" />
		<!-- SAML messages are base64 by definition. -->
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode" />
		<exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode" />
	</rule>

	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="documentElement" />
				<element value="nextSibling" />
				<element value="textContent" />
			</property>
		</properties>
	</rule>

	<rule ref="Generic.PHP.RequireStrictTypes" />
</ruleset>
